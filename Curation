-- recherche doublons de citation
log enable (3,1) ;
SPARQL SELECT ?doc (GROUP_CONCAT(DISTINCT ?citation; SEPARATOR="#µ#") AS ?citation)
WHERE {
GRAPH ?g {
?doc dcterms:bibliographicCitation ?citation.
}}
GROUP BY ?doc
HAVING (COUNT(DISTINCT ?citation) > 1) ;


-- recherche doublons de doi et de trucs qui ne sont pas des DOI
log enable (3,1) ;
SPARQL SELECT ?doc (GROUP_CONCAT(DISTINCT ?doi; SEPARATOR="#µ#") AS ?doi)
WHERE {
GRAPH ?g {
?doc bibo:doi ?doi.
FILTER(!REGEX(STR(?doi),'10.'))
}}
GROUP BY ?doc
HAVING (COUNT(DISTINCT ?doi) > 1);


SELECT ?doc (GROUP_CONCAT(DISTINCT ?doi; SEPARATOR="#µ#") AS ?doi)
WHERE {
GRAPH ?g {
?doc bibo:doi ?doi.
FILTER(REGEX(STR(?g),'journals'))
}}
GROUP BY ?doc
HAVING (COUNT(DISTINCT ?doi) > 1)
LIMIT 10


