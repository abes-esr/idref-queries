-- dans ISQL

-- recherche doublons de date
log enable (3,1) ;
SPARQL 
SELECT ?doc (GROUP_CONCAT(DISTINCT ?date ; SEPARATOR="#µ#") AS ?dates)
WHERE {
  GRAPH ?g {
    ?doc dc:date ?date .
  }
}
GROUP BY ?doc
HAVING (COUNT(DISTINCT ?date) > 1) ;

-- recherche doublons de citation
log enable (3,1) ;
SPARQL SELECT ?doc (GROUP_CONCAT(DISTINCT ?citation; SEPARATOR="#µ#") AS ?citation)
WHERE {
  GRAPH ?g {
    ?doc dcterms:bibliographicCitation ?citation.
  }
}
GROUP BY ?doc
HAVING (COUNT(DISTINCT ?citation) > 1) ;
